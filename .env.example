OTS_TAG=master
OTS_FQDN=ots.example.org
POSTGRES_USER=ots
POSTGRES_PASSWORD=CHANGE_ME_bitte_aendern
POSTGRES_DB=ots

# ----- External Traefik -----
# Name of the (already existing) docker network the external Traefik runs in.
TRAEFIK_NETWORK=traefik
# Certificate resolver configured in the external Traefik (for the WebUI on :443).
TRAEFIK_CERTRESOLVER=letsencrypt
# Entrypoint names configured in the external Traefik.
# :80
TRAEFIK_WEB_ENTRYPOINT=web
# :443
TRAEFIK_WEBSECURE_ENTRYPOINT=websecure
# :8080 Marti API
TRAEFIK_MARTI_ENTRYPOINT=takapi
# :8443 Marti API, mTLS via TCP passthrough
TRAEFIK_MARTI_TLS_ENTRYPOINT=takapisecure
# :8446 certificate enrollment via TCP passthrough
TRAEFIK_ENROLLMENT_ENTRYPOINT=takace
